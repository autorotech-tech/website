{
  "manifest_version": 3,
  "name": "Job Responder",
  "description": "Персонализированные отклики: парсинг любой страницы вакансии + Resume RAG (тестовый режим без login)",
  "version": "0.2.0",
  "permissions": ["storage", "sidePanel", "activeTab", "scripting", "tabs"],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "https://swoop.autoro.tech/*",
    "http://127.0.0.1:8900/*",
    "http://localhost:8900/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Job Responder"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/page-extract.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "job-responder@autoro.tech"
    }
  }
}
