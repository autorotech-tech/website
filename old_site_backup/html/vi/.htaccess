# Включить сжатие gzip
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Перенаправление на /ru/ если язык браузера ru (русский)
RewriteCond %{HTTP:Accept-Language} ^ru [NC]
RewriteCond %{REQUEST_URI} ^/$
RewriteRule ^(.*)$ /ru/ [L,R=301]

# Перенаправление на /es/ если язык браузера es (испанский)
RewriteCond %{HTTP:Accept-Language} ^es [NC]
RewriteCond %{REQUEST_URI} ^/$
RewriteRule ^(.*)$ /es/ [L,R=301]


# Перенаправление на /it/ если язык браузера it (итальянский)
RewriteCond %{HTTP:Accept-Language} ^it [NC]
RewriteCond %{REQUEST_URI} ^/$
RewriteRule ^(.*)$ /it/ [L,R=301]


# Перенаправление на /it/ если язык браузера vi
RewriteCond %{HTTP:Accept-Language} ^it [NC]
RewriteCond %{REQUEST_URI} ^/$
RewriteRule ^(.*)$ /vi/ [L,R=301]

# Кэширование статики
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType application/x-javascript "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresDefault "access plus 1 month"
</IfModule>

# SEO: перенаправление на https
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# SEO: canonical trailing slash
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !(\.[a-zA-Z0-9]{1,5}|/)$
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1/ [L,R=301] 