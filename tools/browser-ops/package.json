{
  "name": "browser-ops",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Table-driven job-board signup / reverse-link browser automation with Playwright + mousecrack",
  "scripts": {
    "register": "tsx src/register-run.ts",
    "help": "tsx src/register-run.ts --help",
    "dry-run": "tsx src/register-run.ts --csv examples/registrations.csv --dry-run"
  },
  "keywords": ["playwright", "mousecrack", "browser-ops"],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "csv-parse": "^7.0.1",
    "dotenv": "^17.4.2",
    "mousecrack": "^0.1.1",
    "playwright": "^1.62.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
