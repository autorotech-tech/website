# Локальный obsidian-relay на Mac (второй канал для agent-api dual sync).
# Скопируйте: cp scripts/obsidian-local-relay.env.example scripts/obsidian-local-relay.env
# Укажите путь к vault, который открыт в Obsidian на Mac.

# Vault, который открыт в Obsidian → Open folder as vault
OBSIDIAN_VAULT_DIR=/Users/vlad_x/Desktop/soft/ObsidianVault
OBSIDIAN_LOCAL_RELAY_PORT=8788
OBSIDIAN_SYNC_TOKEN=autoro_obsidian_sync_v1

# На VPS в .env agent-api (доступ с сервера до Mac — Tailscale / LAN):
# OBSIDIAN_SYNC_WEBHOOK_URL_SECONDARY=http://100.x.x.x:8788/sync
# или
# OBSIDIAN_LOCAL_RELAY_URL=http://100.x.x.x:8788/sync
