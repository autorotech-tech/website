        "url": "=https://swoop.autoro.tech/api/internal/click/{{$json.click_id}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{'Basic ' + Buffer.from(($env.INTERNAL_API_USER || 'n8n') + ':' + $env.INTERNAL_API_PASSWORD).toString('base64')}}"
            }
          ]
        },
        "options": {}
      },
      "id": "http_get_click_context",
      "name": "Get Click Context",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1160,
        420
      ]
    },
    {
      "parameters": {
        "mode": "mergeByPosition",
        "options": {}
      },
      "id": "merge_queue_click",
      "name": "Merge Queue + Click",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        1390,
        340
      ]
    },
    {
      "parameters": {
        "jsCode": "const ts = Math.floor(Date.now() / 1000);\nconst fbc = $json.fbclid ? `fb.1.${ts}.${$json.fbclid}` : undefined;\n\nreturn [{\n  ...$json,\n  event_name: $json.event_name || 'Lead',\n  fb_event_id: $json.fb_event_id || `${$json.click_id}-${Date.now()}`,\n  event_time: ts,\n  fbc,\n}];"
      },
      "id": "code_prepare_payload",
      "name": "Prepare Meta Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1620,
        340
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{$json.fb_pixel_id}}/events",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "access_token",
              "value": "={{$json.fb_capi_token}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"data\": [\n    {\n      \"event_name\": $json.event_name,\n      \"event_time\": $json.event_time,\n      \"event_id\": $json.fb_event_id,\n      \"action_source\": \"system_generated\",\n      \"user_data\": {\n        \"client_ip_address\": $json.ip_address,\n        \"client_user_agent\": $json.user_agent,\n        \"fbc\": $json.fbc,\n        \"fbclid\": $json.fbclid\n      },\n      \"custom_data\": {\n        \"click_id\": $json.click_id,\n        \"utm_source\": $json.utm_source,\n        \"utm_medium\": $json.utm_medium,\n        \"utm_campaign\": $json.utm_campaign\n      }\n    }\n  ]\n}",
        "options": {
          "ignoreResponseCode": true
        }
      },
      "id": "http_send_meta",
      "name": "Send Meta CAPI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1850,
        420
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "mode": "mergeByPosition",
        "options": {}
      },
      "id": "merge_payload_result",
      "name": "Merge Payload + Meta Result",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        2080,
        340
      ]
    },
    {
      "parameters": {
        "jsCode": "const eventsReceived = Number($json.events_received || 0);\nconst success = eventsReceived > 0;\nconst errorMessage = success\n  ? null\n  : String(\n      ($json.error && ($json.error.message || JSON.stringify($json.error))) ||\n      $json.message ||\n      JSON.stringify($json).slice(0, 500)\n    ).slice(0, 500);\n\nreturn [{\n  ...$json,\n  status: success ? 'success' : 'failed',\n  postback_error_message: errorMessage,\n}];"
      },
      "id": "code_mark_result",
      "name": "Mark Retry Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2300,
        340
      ]
    },
