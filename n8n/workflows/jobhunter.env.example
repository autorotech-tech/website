# Jobhunter HH - credentials / env (do not commit real secrets)
# Live copy for Autoro Hunt server: ai-job-search/AutoroHunt.env
# Docs: docs/jobhunter/oauth-setup.md
# MCP ref: https://github.com/autorotech-tech/headhunter-mcp-server

# HH application (dev.hh.ru/admin)
HH_CLIENT_ID=
HH_CLIENT_SECRET=
# App token = POST hh.ru/oauth/token grant_type=client_credentials (required for /vacancies)
HH_APP_TOKEN=
# User/manager OAuth access token (optional for search; MCP name: HH_ACCESS_TOKEN)
HH_USER_TOKEN=
HH_ACCESS_TOKEN=
HH_REFRESH_TOKEN=
HH_REDIRECT_URI=https://tech.autoro.tech/rest/oauth2-credential/callback
HH_USER_AGENT=AutoroHunt/0.1 (your@email.example)

# Optional Apify fallback (Swoop Admin -> Settings -> apify_keys)
APIFY_TOKEN=
# easyapi/hh-ru-job-scraper | jobsapi/hh-ru-jobs-search-scraper | automation-lab/headhunter-jobs-scraper

# Google Sheets (n8n Google Sheets OAuth credential preferred)
JOBHUNTER_SHEET_ID=
JOBHUNTER_SHEET_VACANCIES=vacancies
JOBHUNTER_SHEET_PROFILE=profile
JOBHUNTER_SHEET_FILTERS=filters

# Paths on n8n host
JOBHUNTER_ROOT=/data/autoro/website
JOBHUNTER_PYTHON=python3

# Safety defaults mirrored in filters sheet
JOBHUNTER_AUTO_APPLY=false
JOBHUNTER_AUTO_EMAIL=false
JOBHUNTER_DAILY_CAP=5
