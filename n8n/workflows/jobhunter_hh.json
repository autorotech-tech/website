        },
        "options": {
          "returnFirstMatch": false
        }
      },
      "id": "sheets_read_vacancies_keys",
      "name": "Sheets Read Vacancy Keys",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1100, 400]
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Config Pipeline').first().json;\nconst filtersRows = $('Sheets Read Filters').all().map(i => i.json);\nconst profileRows = $('Sheets Read Profile').all().map(i => i.json);\nconst vacRows = $('Sheets Read Vacancy Keys').all().map(i => i.json);\nconst host = cfg.host || 'uz';\nconst filters = filtersRows.find(r => String(r.host || '').toLowerCase() === host) || filtersRows[0] || {};\nconst profile = profileRows.find(r => String(r.active || 'TRUE').toUpperCase() === 'TRUE') || profileRows[0] || {};\nconst existing = vacRows\n  .filter(r => r.vacancy_id)\n  .map(r => `${r.host || host}:${r.vacancy_id}`);\nreturn [{\n  json: {\n    ...cfg,\n    filters,\n    profile,\n    existing_keys: existing.join(','),\n    auto_apply: String(filters.auto_apply || 'FALSE').toUpperCase() === 'TRUE',\n    auto_email: String(filters.auto_email || 'FALSE').toUpperCase() === 'TRUE',\n    daily_cap: Number(filters.daily_cap || 5),\n    pause_on_block: String(filters.pause_on_block || 'TRUE').toUpperCase() !== 'FALSE',\n  }\n}];"
      },
      "id": "code_prepare_context",
      "name": "Prepare Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1320, 400]
    },
    {
      "parameters": {
        "command": "={{`mkdir -p /tmp/jobhunter && cat > /tmp/jobhunter/filters.json <<'EOF'\\n${JSON.stringify($json.filters)}\\nEOF\\ncat > /tmp/jobhunter/profile.json <<'EOF'\\n${JSON.stringify($json.profile)}\\nEOF\\n${$json.python} ${$json.jobhunter_root}/scripts/jobhunter/cli.py pipeline --host ${$json.host} --filters /tmp/jobhunter/filters.json --profile /tmp/jobhunter/profile.json --existing-keys \"${$json.existing_keys}\" --no-fetch-sites --out /tmp/jobhunter/pipeline_out.json && cat /tmp/jobhunter/pipeline_out.json`}}"
      },
      "id": "exec_pipeline",
      "name": "Exec Pipeline CLI",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [1540, 400],
      "notes": "Uses --no-fetch-sites by default in n8n for speed; enable site fetch in a separate enrich pass"
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst stdout = raw.stdout || raw.message || (typeof raw === 'string' ? raw : '');\nlet payload;\ntry {\n  const text = typeof stdout === 'string' ? stdout : JSON.stringify(raw);\n  const start = text.indexOf('{');\n  payload = JSON.parse(text.slice(start));\n} catch (e) {\n  return [{ json: { error: 'parse_failed', raw } }];\n}\nconst items = payload.items || [];\nreturn items.map((row) => ({ json: row }));"
      },
      "id": "code_parse_pipeline",
      "name": "Parse Pipeline JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1760, 400]
    },
