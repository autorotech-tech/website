      "id": "sheets_read_filters_apply",
      "name": "Sheets Read Filters Apply",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [880, 760]
    },
    {
      "parameters": {
        "jsCode": "const awaiting = $('Sheets Read Awaiting Approve').all().map(i => i.json);\nconst filtersRows = $('Sheets Read Filters Apply').all().map(i => i.json);\nconst filters = filtersRows[0] || {};\nconst autoApply = String(filters.auto_apply || 'FALSE').toUpperCase() === 'TRUE';\nconst approved = awaiting.filter(r => String(r.approve || '').toUpperCase() === 'YES');\nif (!autoApply) {\n  return [{ json: { skipped: true, reason: 'auto_apply_false', approved_count: approved.length } }];\n}\nif (!approved.length) {\n  return [{ json: { skipped: true, reason: 'no_approved_rows' } }];\n}\nconst cfg = $('Config Apply').first().json;\nreturn [{\n  json: {\n    ...cfg,\n    filters,\n    approved,\n    daily_cap: Number(filters.daily_cap || 5),\n  }\n}];"
      },
      "id": "code_gate_apply",
      "name": "Human Gate Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 760]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{$json.skipped}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "notTrue"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if_should_apply",
      "name": "IF Should Apply",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1320, 760]
    },
    {
      "parameters": {
        "command": "={{`mkdir -p /tmp/jobhunter && cat > /tmp/jobhunter/apply_in.json <<'EOF'\\n${JSON.stringify({items:$json.approved})}\\nEOF\\ncat > /tmp/jobhunter/filters.json <<'EOF'\\n${JSON.stringify($json.filters)}\\nEOF\\n${$json.python} ${$json.jobhunter_root}/scripts/jobhunter/cli.py apply --input /tmp/jobhunter/apply_in.json --filters /tmp/jobhunter/filters.json --daily-cap ${$json.daily_cap} --dry-run --out /tmp/jobhunter/apply_out.json && cat /tmp/jobhunter/apply_out.json`}}"
      },
      "id": "exec_apply_dry",
      "name": "Exec Apply Dry-Run",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [1560, 700],
      "notes": "Default dry-run. Switch to --real only after go-live checklist. Keep test account tokens."
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { ok: true, note: 'apply skipped by human gate or auto_apply=false', detail: $json } }];"
      },
      "id": "noop_skip_apply",
      "name": "Skip Apply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1560, 860]
    }
